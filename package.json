{
	"name": "what-now",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist",
		"start": "node --enable-source-maps -r module-alias/register dist/index.js",
		"format": "biome format --write",
		"lint": "biome check"
	},
	"description": "A toolset designed to help developers decide what to work on next",
	"bin": {
		"what-now": "dist/index.js"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "^4.0.2",
		"ai": "^6.0.0",
		"chalk": "^5.3.0",
		"commander": "^11.0.0",
		"conf": "^15.0.2",
		"module-alias": "^2.2.2",
		"octokit": "^5.0.5",
		"ora": "^9.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/node": "^20.19.27",
		"lefthook": "^2.0.12",
		"typescript": "^5.3.0"
	}
}
