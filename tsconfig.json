{
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"outDir": "dist",
		"rootDir": "src",
		"moduleResolution": "node16",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": false,
		"skipLibCheck": true,
		"allowJs": false,
		"allowSyntheticDefaultImports": true,
		"noEmitOnError": false,
		"importsNotUsedAsValues": "remove",
		"allowImportingTsExtensions": false,
		"baseUrl": "./src",
		"paths": {
			"*": ["*"]
		}
	},
	"include": ["src/**/*"]
}
